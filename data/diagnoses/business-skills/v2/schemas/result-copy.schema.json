{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://human-os.site/schemas/business-skills-v2-result-copy.schema.json",
  "title": "Business Skills V2 Result Copy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contentVersion",
    "status",
    "diagnosisId",
    "renderingPolicy",
    "types"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0.0"
    },
    "contentVersion": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "const": "locked-not-implemented"
    },
    "diagnosisId": {
      "const": "business-skills"
    },
    "renderingPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "representativeNumericCopyIncluded",
        "currentYou",
        "quantitativeAnalysis",
        "stableSections"
      ],
      "properties": {
        "representativeNumericCopyIncluded": {
          "const": false
        },
        "currentYou": {
          "type": "string"
        },
        "quantitativeAnalysis": {
          "type": "string"
        },
        "stableSections": {
          "type": "string"
        }
      }
    },
    "types": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/type"
      }
    }
  },
  "$defs": {
    "paragraphs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "thinking": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "see",
        "decide",
        "move",
        "land"
      ],
      "properties": {
        "see": {
          "$ref": "#/$defs/paragraphs"
        },
        "decide": {
          "$ref": "#/$defs/paragraphs"
        },
        "move": {
          "$ref": "#/$defs/paragraphs"
        },
        "land": {
          "$ref": "#/$defs/paragraphs"
        }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "body"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "$ref": "#/$defs/paragraphs"
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mainRouteId",
        "subRouteId",
        "internalNames",
        "currentYou",
        "quantitativeAnalysis",
        "harshOneLiner",
        "workThinking",
        "strengthScenes",
        "failureFlow",
        "perception",
        "environment",
        "roles",
        "partner",
        "oneChange",
        "share"
      ],
      "properties": {
        "mainRouteId": {
          "type": "string"
        },
        "subRouteId": {
          "type": "string"
        },
        "internalNames": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mainRoute",
            "subRoute"
          ],
          "properties": {
            "mainRoute": {
              "type": "string"
            },
            "subRoute": {
              "type": "string"
            }
          }
        },
        "currentYou": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "baseSentences",
            "numericAppendSlots"
          ],
          "properties": {
            "baseSentences": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "numericAppendSlots": {
              "type": "array",
              "prefixItems": [
                {
                  "const": "topAbilities"
                },
                {
                  "const": "relativeLagAbility"
                },
                {
                  "const": "axisPair"
                }
              ],
              "items": false
            }
          }
        },
        "quantitativeAnalysis": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "slots"
          ],
          "properties": {
            "mode": {
              "const": "generated-from-numeric-rules"
            },
            "slots": {
              "type": "array",
              "prefixItems": [
                {
                  "const": "topAxes"
                },
                {
                  "const": "centralAxis"
                },
                {
                  "const": "topAbilities"
                },
                {
                  "const": "relativeLagAbility"
                }
              ],
              "items": false
            }
          }
        },
        "harshOneLiner": {
          "type": "string",
          "minLength": 1
        },
        "workThinking": {
          "$ref": "#/$defs/thinking"
        },
        "strengthScenes": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/scene"
          }
        },
        "failureFlow": {
          "$ref": "#/$defs/paragraphs"
        },
        "perception": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "intent",
            "external"
          ],
          "properties": {
            "intent": {
              "$ref": "#/$defs/paragraphs"
            },
            "external": {
              "$ref": "#/$defs/paragraphs"
            }
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fit",
            "avoid"
          ],
          "properties": {
            "fit": {
              "$ref": "#/$defs/paragraphs"
            },
            "avoid": {
              "$ref": "#/$defs/paragraphs"
            }
          }
        },
        "roles": {
          "$ref": "#/$defs/paragraphs"
        },
        "partner": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "typeId",
            "typeName",
            "body"
          ],
          "properties": {
            "typeId": {
              "type": "string"
            },
            "typeName": {
              "type": "string"
            },
            "body": {
              "$ref": "#/$defs/paragraphs"
            }
          }
        },
        "oneChange": {
          "$ref": "#/$defs/paragraphs"
        },
        "share": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "typeLine",
            "bodyLines"
          ],
          "properties": {
            "typeLine": {
              "type": "string"
            },
            "bodyLines": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "type": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "typeNo",
        "typeId",
        "typeName",
        "englishName",
        "baseCode",
        "catchCopy",
        "routes"
      ],
      "properties": {
        "typeNo": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "typeId": {
          "type": "string"
        },
        "typeName": {
          "type": "string"
        },
        "englishName": {
          "type": "string"
        },
        "baseCode": {
          "type": "string",
          "pattern": "^[TA][OS][IG][EF]$"
        },
        "catchCopy": {
          "type": "string",
          "minLength": 1
        },
        "routes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/route"
          }
        }
      }
    }
  }
}