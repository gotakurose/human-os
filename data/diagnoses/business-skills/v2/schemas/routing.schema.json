{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://human-os.site/schemas/business-skills-v2-routing.schema.json",
  "title": "Business Skills V2 Routing",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contentVersion",
    "status",
    "diagnosisId",
    "scoring",
    "types"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0.0"
    },
    "contentVersion": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "const": "locked-implementation-ready"
    },
    "diagnosisId": {
      "const": "business-skills"
    },
    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "componentWeights",
        "evidenceResponseMatch",
        "abilityRankMatch",
        "abilityProfileWeights",
        "axisRankWeights",
        "confidenceThresholds",
        "tieBreakOrder",
        "minEvidencePerRoute",
        "evidenceWeightFormula",
        "abilityRankSource",
        "abilityTiePriority",
        "axisRankSource",
        "axisTiePriority",
        "axisRoleRankMatch",
        "axisMatchFormula",
        "confidenceGapScope",
        "finalTieBreak",
        "selectionLocation",
        "resultUrlParams"
      ],
      "properties": {
        "componentWeights": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evidence",
            "abilities",
            "axes"
          ],
          "properties": {
            "evidence": {
              "const": 0.55
            },
            "abilities": {
              "const": 0.3
            },
            "axes": {
              "const": 0.15
            }
          }
        },
        "evidenceResponseMatch": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "strongTarget",
            "slightTarget",
            "slightOpposite",
            "strongOpposite"
          ],
          "properties": {
            "strongTarget": {
              "const": 1.0
            },
            "slightTarget": {
              "const": 0.75
            },
            "slightOpposite": {
              "const": 0.25
            },
            "strongOpposite": {
              "const": 0.0
            }
          }
        },
        "abilityRankMatch": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rank1",
            "rank2",
            "rank3",
            "rank4",
            "rank5"
          ],
          "properties": {
            "rank1": {
              "const": 1.0
            },
            "rank2": {
              "const": 0.82
            },
            "rank3": {
              "const": 0.58
            },
            "rank4": {
              "const": 0.34
            },
            "rank5": {
              "const": 0.15
            }
          }
        },
        "abilityProfileWeights": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "top1",
            "top2"
          ],
          "properties": {
            "top1": {
              "const": 0.6
            },
            "top2": {
              "const": 0.4
            }
          }
        },
        "axisRankWeights": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "top1",
            "top2",
            "central"
          ],
          "properties": {
            "top1": {
              "const": 0.5
            },
            "top2": {
              "const": 0.3
            },
            "central": {
              "const": 0.2
            }
          }
        },
        "confidenceThresholds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "highMinGap",
            "mediumMinGap"
          ],
          "properties": {
            "highMinGap": {
              "const": 0.04
            },
            "mediumMinGap": {
              "const": 0.015
            }
          }
        },
        "tieBreakOrder": {
          "type": "array",
          "prefixItems": [
            {
              "const": "evidence"
            },
            {
              "const": "abilities"
            },
            {
              "const": "axes"
            },
            {
              "const": "routeArrayOrder"
            }
          ],
          "items": false
        },
        "minEvidencePerRoute": {
          "const": 3
        },
        "evidenceWeightFormula": {
          "type": "string",
          "minLength": 1
        },
        "abilityRankSource": {
          "const": "displayScoreD"
        },
        "abilityTiePriority": {
          "type": "array",
          "prefixItems": [
            {
              "const": "logic"
            },
            {
              "const": "execution"
            },
            {
              "const": "sales"
            },
            {
              "const": "creativity"
            },
            {
              "const": "management"
            }
          ],
          "items": false
        },
        "axisRankSource": {
          "const": "typeSideDisplayScore"
        },
        "axisTiePriority": {
          "type": "array",
          "prefixItems": [
            {
              "const": "thinking_action"
            },
            {
              "const": "offensive_stable"
            },
            {
              "const": "solo_team"
            },
            {
              "const": "divergent_convergent"
            }
          ],
          "items": false
        },
        "axisRoleRankMatch": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "top1",
            "top2",
            "central"
          ],
          "properties": {
            "top1": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "rank1",
                "rank2",
                "rank3",
                "rank4"
              ],
              "properties": {
                "rank1": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "rank2": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "rank3": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "rank4": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            },
            "top2": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "rank1",
                "rank2",
                "rank3",
                "rank4"
              ],
              "properties": {
                "rank1": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "rank2": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "rank3": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "rank4": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            },
            "central": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "rank1",
                "rank2",
                "rank3",
                "rank4"
              ],
              "properties": {
                "rank1": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "rank2": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "rank3": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "rank4": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          }
        },
        "axisMatchFormula": {
          "type": "string",
          "minLength": 1
        },
        "confidenceGapScope": {
          "const": "topTwoSubRoutesWithinType"
        },
        "finalTieBreak": {
          "const": "routeArrayOrder"
        },
        "selectionLocation": {
          "const": "questionFlowBeforeNavigation"
        },
        "resultUrlParams": {
          "type": "array",
          "prefixItems": [
            {
              "const": "ta"
            },
            {
              "const": "os"
            },
            {
              "const": "st"
            },
            {
              "const": "dc"
            },
            {
              "const": "av"
            },
            {
              "const": "sr"
            },
            {
              "const": "cf"
            }
          ],
          "items": false
        }
      }
    },
    "types": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/type"
      }
    }
  },
  "$defs": {
    "abilityKey": {
      "enum": [
        "logic",
        "execution",
        "sales",
        "creativity",
        "management"
      ]
    },
    "axisPoleKey": {
      "enum": [
        "thinking",
        "action",
        "offensive",
        "stable",
        "individual",
        "group",
        "divergent",
        "convergent"
      ]
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "axes",
        "abilities"
      ],
      "properties": {
        "axes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "thinking",
            "action",
            "offensive",
            "stable",
            "individual",
            "group",
            "divergent",
            "convergent"
          ],
          "properties": {
            "thinking": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "action": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "offensive": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "stable": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "individual": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "group": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "divergent": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "convergent": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        "abilities": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "logic",
            "execution",
            "sales",
            "creativity",
            "management"
          ],
          "properties": {
            "logic": {
              "type": "integer",
              "minimum": 50,
              "maximum": 100
            },
            "execution": {
              "type": "integer",
              "minimum": 50,
              "maximum": 100
            },
            "sales": {
              "type": "integer",
              "minimum": 50,
              "maximum": 100
            },
            "creativity": {
              "type": "integer",
              "minimum": 50,
              "maximum": 100
            },
            "management": {
              "type": "integer",
              "minimum": 50,
              "maximum": 100
            }
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "questionId",
        "targetSide",
        "weight"
      ],
      "properties": {
        "questionId": {
          "type": "string",
          "pattern": "^q(?:0[1-9]|[1-3][0-9]|40)$"
        },
        "targetSide": {
          "enum": [
            "A",
            "B"
          ]
        },
        "weight": {
          "type": "number",
          "minimum": 1.0,
          "maximum": 1.45
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mainRouteId",
        "mainRouteName",
        "subRouteId",
        "subRouteName",
        "evidence",
        "abilityProfile",
        "axisProfile",
        "representativeScores",
        "bestPartnerTypeId"
      ],
      "properties": {
        "mainRouteId": {
          "type": "string",
          "pattern": "^[a-z0-9-]+\\.m\\d{2}$"
        },
        "mainRouteName": {
          "type": "string",
          "minLength": 1
        },
        "subRouteId": {
          "type": "string",
          "pattern": "^[a-z0-9-]+\\.m\\d{2}\\.s\\d{2}$"
        },
        "subRouteName": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "abilityProfile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "top1",
            "top2",
            "relativeLag"
          ],
          "properties": {
            "top1": {
              "$ref": "#/$defs/abilityKey"
            },
            "top2": {
              "$ref": "#/$defs/abilityKey"
            },
            "relativeLag": {
              "$ref": "#/$defs/abilityKey"
            }
          }
        },
        "axisProfile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "top1",
            "top2",
            "central"
          ],
          "properties": {
            "top1": {
              "$ref": "#/$defs/axisPoleKey"
            },
            "top2": {
              "$ref": "#/$defs/axisPoleKey"
            },
            "central": {
              "$ref": "#/$defs/axisPoleKey"
            }
          }
        },
        "representativeScores": {
          "$ref": "#/$defs/scores"
        },
        "bestPartnerTypeId": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        }
      }
    },
    "type": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "typeNo",
        "typeId",
        "typeName",
        "englishName",
        "baseCode",
        "routes"
      ],
      "properties": {
        "typeNo": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "typeId": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "typeName": {
          "type": "string",
          "minLength": 1
        },
        "englishName": {
          "type": "string",
          "minLength": 1
        },
        "baseCode": {
          "type": "string",
          "pattern": "^[TA][OS][IG][EF]$"
        },
        "routes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/route"
          }
        }
      }
    }
  }
}