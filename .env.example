# 環境変数テンプレート
# このファイルをコピーして .env.local を作成し、値を設定してください
# cp .env.example .env.local

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics（Phase 1 で設定）
NEXT_PUBLIC_GA_ID=

# LLM API（Phase 4 以降で設定）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Stripe（Phase 4 以降で設定）
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
